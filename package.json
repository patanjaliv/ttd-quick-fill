{
  "name": "ttd-quick-fill",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source browser extension that fills TTD (Tirumala) booking forms from saved pilgrim details.",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/",
    "test:e2e": "node e2e/run.mjs",
    "lint": "web-ext lint --source-dir . --ignore-files 'dist/**' 'node_modules/**' 'tests/**' 'e2e/**' 'package.json' 'package-lock.json' '*.md'",
    "build": "web-ext build --source-dir . --artifacts-dir dist --overwrite-dest --ignore-files 'dist/**' 'node_modules/**' 'tests/**' 'e2e/**' 'package.json' 'package-lock.json' '*.md'"
  },
  "devDependencies": { "web-ext": "^8.0.0" }
}
