{
  "manifest_version": 3,
  "name": "TTD Quick Fill",
  "version": "0.1.0",
  "description": "Save pilgrim details once and fill TTD (Tirumala) darshan booking forms in one click. Unofficial, free and open source.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "TTD Quick Fill",
    "default_popup": "popup/index.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://ttdevasthanams.ap.gov.in/*",
    "https://tirupatibalaji.ap.gov.in/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://ttdevasthanams.ap.gov.in/*", "https://tirupatibalaji.ap.gov.in/*"],
      "js": ["content/fill.js"],
      "css": ["content/fill.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "browser_specific_settings": {
    "gecko": {
      "id": "ttd-quick-fill@opensource.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
